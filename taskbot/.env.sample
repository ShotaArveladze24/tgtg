# Telegram bot token from @BotFather
TASKBOT_TOKEN=123456:ABC-your-token
# Comma-separated Telegram user ids allowed to use the bot (send /whoami to the bot to get yours)
TASKBOT_ALLOWED_USERS=11111111,22222222
TASKBOT_DB=/data/taskbot.db
TASKBOT_TIMEZONE=Europe/Rome
TASKBOT_DEFAULT_OWNER=PNC
TASKBOT_DEFAULT_PROJECT=No PROJECT
TASKBOT_DEFAULT_DEADLINE_DAYS=7
# Eisenhower: a task is "urgent" when its deadline is within this many days (or overdue)
TASKBOT_URGENT_DAYS=3
# Time of day used as "due time" for relative reminders such as -1d / -2h
TASKBOT_DEADLINE_TIME=09:00
TASKBOT_DIGEST_TIME=08:00
TASKBOT_REMINDER_INTERVAL=60
TASKBOT_FETCH_LINK_TITLES=1
TASKBOT_LOG_LEVEL=INFO
